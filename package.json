{
  "name": "@local/dsh-secretary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lets one secretary agent create projects (workspaces) and run threads (sessions) inside them.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
